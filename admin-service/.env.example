# Copy to .env for local development only; do not commit .env.
DB_URL=jdbc:mysql://localhost:3306/mbhoni_es?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-local-database-password
# Use update only while reconciling a legacy schema. Production should use
# validate once all schema changes are represented by Flyway migrations.
JPA_DDL_AUTO=update

MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=noreply@example.com
APP_ADMIN_EMAIL=admin@example.com

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
