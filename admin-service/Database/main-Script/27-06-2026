USE mbhoni_es;

CREATE TABLE IF NOT EXISTS subscription_plans (
    id BIGINT NOT NULL AUTO_INCREMENT,
    code VARCHAR(80) NOT NULL,
    name VARCHAR(120) NOT NULL,
    description VARCHAR(500),
    monthly_price DECIMAL(19, 2) DEFAULT 0.00,
    annual_price DECIMAL(19, 2) DEFAULT 0.00,
    max_users INT,
    max_storage_mb INT,
    api_access_enabled BIT(1) NOT NULL DEFAULT b'0',
    branding_enabled BIT(1) NOT NULL DEFAULT b'0',
    custom_domain_enabled BIT(1) NOT NULL DEFAULT b'0',
    active BIT(1) NOT NULL DEFAULT b'1',
    created_at DATETIME(6),
    created_by VARCHAR(255),
    updated_at DATETIME(6),
    updated_by VARCHAR(255),
    PRIMARY KEY (id),
    UNIQUE KEY uk_subscription_plans_code (code)
);

CREATE TABLE IF NOT EXISTS tenant_subscriptions (
    id BIGINT NOT NULL AUTO_INCREMENT,
    tenant_id BIGINT NOT NULL,
    plan_id BIGINT NOT NULL,
    status VARCHAR(40) NOT NULL,
    billing_cycle VARCHAR(40) NOT NULL,
    start_date DATE,
    end_date DATE,
    trial_ends_at DATE,
    auto_renew BIT(1) NOT NULL DEFAULT b'1',
    created_at DATETIME(6),
    created_by VARCHAR(255),
    updated_at DATETIME(6),
    updated_by VARCHAR(255),
    PRIMARY KEY (id),
    UNIQUE KEY uk_tenant_subscriptions_tenant (tenant_id),
    KEY idx_tenant_subscriptions_plan (plan_id),
    CONSTRAINT fk_tenant_subscriptions_tenant
        FOREIGN KEY (tenant_id)
        REFERENCES tenants (id),
    CONSTRAINT fk_tenant_subscriptions_plan
        FOREIGN KEY (plan_id)
        REFERENCES subscription_plans (id)
);

